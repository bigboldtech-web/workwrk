# ──────────────────────────────────────────────────────────────
# WorkwrK — environment variables
# Copy to `.env` for local dev. In production, set these in your
# hosting provider's dashboard (Vercel, AWS, Railway, etc.).
# ──────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────
# Postgres connection string. Neon / Supabase / RDS / local.
DATABASE_URL="postgresql://user:password@localhost:5432/workwrk?schema=public"

# ─── NextAuth ─────────────────────────────────────────────────
# Secret for signing JWTs. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ─── AI Engine ────────────────────────────────────────────────
# Required for /api/ai, AI signals, KRA/SOP generation.
# Enterprise agreement with Anthropic — zero-retention, zero-training.
ANTHROPIC_API_KEY=""

# ─── Google SSO (optional) ────────────────────────────────────
# Enable Google sign-in on /login. Create at console.cloud.google.com
# Authorized redirect: $NEXTAUTH_URL/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Stripe billing (optional) ────────────────────────────────
# Required for self-serve subscription billing. Get from stripe.com.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs — create in Stripe dashboard matching the pricing on /pricing.
STRIPE_PRICE_GROWTH_PER_USER=""
STRIPE_PRICE_TEAM_FLAT=""
STRIPE_PRICE_GROWTH_FLAT=""
STRIPE_PRICE_SCALE_FLAT=""

# ─── Cron secret ──────────────────────────────────────────────
# Shared secret between root's crontab and every /api/cron job
# (scripts/CRON-SETUP.md). Unset, every job answers 503 and runs nothing.
# Sent as header: X-Cron-Secret or Authorization: Bearer <value>
CRON_SECRET=""

# ─── Email delivery (SMTP) ────────────────────────────────────
# Nothing is sent unless EMAIL_ENABLED is "true". Without it, development
# prints each email to the console, and production HOLDS the queue (nothing is
# marked sent) until mail is set up. These are the only names the code reads
# (src/lib/email.ts).
EMAIL_ENABLED=""
SMTP_HOST=""
# 465 connects over TLS; other ports upgrade to TLS when the server offers it.
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="WorkwrK <noreply@workwrk.com>"
# Where a failing scheduled job sends an alert (at most one per job in six
# hours). Optional. Not the email-queue job's: its alert would wait in the
# queue that is failing.
OPS_ALERT_EMAIL=""

# ─── Storage (optional) ───────────────────────────────────────
# Required for Scribe screenshot uploads + avatars. S3-compatible.
# Works with Linode Object Storage, Cloudflare R2, AWS S3, B2 etc.
#
# Linode Chennai example:
#   S3_BUCKET=workwrk
#   S3_REGION=in-maa-1
#   S3_ENDPOINT=https://in-maa-1.linodeobjects.com
# AWS S3: leave S3_ENDPOINT empty.
# Cloudflare R2: set S3_ENDPOINT and S3_FORCE_PATH_STYLE=true.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET=""
S3_REGION="in-maa-1"
S3_ENDPOINT="https://in-maa-1.linodeobjects.com"
S3_FORCE_PATH_STYLE=""

# ─── External integrations (wire on demand) ───────────────────
# Razorpay — for KPI push + payroll sync
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Keka HRMS
KEKA_API_URL=""
KEKA_API_KEY=""

# HubSpot
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""

# QuickBooks Online — register at developer.intuit.com.
# Redirect URI:  $NEXTAUTH_URL/api/integrations/quickbooks/callback
# Scopes wired in src/lib/integrations/quickbooks.ts (accounting + openid)
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""

# Xero — register at developer.xero.com.
# Redirect URI:  $NEXTAUTH_URL/api/integrations/xero/callback
# Scopes wired in src/lib/integrations/xero.ts (accounting.* + offline_access)
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""

# ─── Feature flags ────────────────────────────────────────────
# Set to "true" to expose experimental features to all tenants.
NEXT_PUBLIC_FLAG_SCRIBE="false"
NEXT_PUBLIC_FLAG_PROCESS_FLOWS="false"

# ─── Staff console (admin.workwrk.com) ────────────────────────
# ADMIN_HOST is REQUIRED in production. When it is set, src/proxy.ts serves
# only /admin, /api/admin, /api/auth and /login on that host and rewrites
# /admin and /api/admin to /404 on every other host, so the console is not
# reachable from the customer app. When it is unset the console still works
# but the split does not: /admin answers on the app host, gated only by the
# PlatformAdmin allow-list (docs/plans/subdomain-architecture.md, scripts/DEPLOY-NOTES.md).
ADMIN_HOST=""
# The customer app's absolute origin. The console's "WorkwrK" back link and
# its My settings link point here, because the admin host does not serve
# product routes. Required alongside ADMIN_HOST.
NEXT_PUBLIC_APP_URL=""
# Optional: the internal staff runbook. When set, the console's top bar shows
# Help ("?") opening it in a new tab; when unset the slot is empty.
STAFF_RUNBOOK_URL=""
# LOCAL DEVELOPMENT ONLY, ignored when NODE_ENV is "production". A fresh
# database has an empty PlatformAdmin table and the only way onto the staff
# list is to be added by someone already on it, so nobody can be first.
# Comma-separated emails that count as staff until their row exists; use it
# once to add yourself through Staff console › Staff, then clear it.
PLATFORM_STAFF_BOOTSTRAP_EMAILS=""
