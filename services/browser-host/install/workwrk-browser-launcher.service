# The browser launcher (docs/plans/browser-host.md Decision 19, 5.5 and
# 8.3): the only part that touches Docker. As wkblaunch, in the docker
# group, with no network at all; it answers the host on the socket systemd
# hands it (workwrk-browser-launcher.socket). Never swapped or dumped (final
# privacy review, M3).
[Unit]
Description=WorkwrK browser launcher
After=docker.service workwrk-browser-launcher.socket
Requires=docker.service workwrk-browser-launcher.socket
[Service]
Type=simple
User=wkblaunch
Group=wkblaunch
SupplementaryGroups=docker
EnvironmentFile=/etc/workwrk-browser-host/host.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/workwrk-browser-host/current/launcher/main.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
OOMScoreAdjust=-900
MemoryMax=256M
MemorySwapMax=0
LimitCORE=0
TasksMax=128
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/workwrk-browser-host
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitNOFILE=65536
[Install]
WantedBy=multi-user.target
